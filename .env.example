# OpenAI
OPENAI_API_KEY=

# Langfuse
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_RELEASE=local-dev

# Container runtime
APP_PORT=3000
APP_STORAGE_PATH=./storage
APP_RESTART_POLICY=unless-stopped
APP_LOG_MAX_SIZE=10m
APP_LOG_MAX_FILE=3
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Image worker
IMAGE_WORKER_ENABLED=false
IMAGE_WORKER_URL=http://127.0.0.1:8001
IMAGE_WORKER_PORT=8001
IMAGE_WORKER_TIMEOUT_MS=
IMAGE_WORKER_TOKEN=
IMAGE_WORKER_PROFILE=full
IMAGE_WORKER_DEVICE=
IMAGE_MODEL_BASE=
IMAGE_MODEL_CONTROLNET=
IMAGE_MODEL_IP_ADAPTER_REPO=
IMAGE_MODEL_IP_ADAPTER_WEIGHT=
IMAGE_NUM_INFERENCE_STEPS=
IMAGE_GUIDANCE_SCALE=
IMAGE_CONTROLNET_SCALE=
IMAGE_IP_ADAPTER_SCALE=
